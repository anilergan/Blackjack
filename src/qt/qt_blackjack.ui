    border: 1px solid rgba(120,124,116,255);  /* Table border */
    gridline-color: rgba(120,124,116,255);  /* Grid lines */
    selection-background-color: rgba(80,100,80,255);  /* Selected cell background */
    selection-color: white;  /* Selected cell text */
    alternate-background-color: #32402F;  /* Alternating row color */
}

QTableWidget::item {
    border-bottom: 1px solid rgba(120,124,116,255);  /* Grid lines */
    padding: 5px;
}

QHeaderView::section {
    background-color: #3A453A;  /* Header background */
    color: white;
    padding: 5px;
    border: 1px solid rgba(120,124,116,255);  /* Header border */
}

QTableCornerButton::section {
    background-color: #3A453A;  /* Top-left corner button */
    border: 1px solid rgba(120,124,116,255);
}

/* ----------- Vertical Scrollbar (Right 5px, Top/Bottom 10px Offset) ----------- */
QScrollBar:vertical {
    background-color: rgb(30,38,32);  /* Scroll track */
    width: 12px;  
    margin: 10px 5px 10px 0px;  /* Offset from top: 10px, bottom: 10px, right: 5px */
    border-radius: 5px;
    border: 1px solid rgba(120,124,116,255); /* Border color similar to table */
}

QScrollBar::handle:vertical {
    background-color: rgba(120,124,116,180);  /* Scroll handle */
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, 
QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical {
    background: none;
}

/* ----------- Horizontal Scrollbar (Bottom 5px, Left/Right 10px Offset) ----------- */
QScrollBar:horizontal {
    background-color: rgb(30,38,32);  /* Scroll track */
    height: 20px;
    margin: 0px 10px 5px 10px;  /* Offset from left: 10px, right: 10px, bottom: 5px */
    border-radius: 10px;
    border: 1px solid rgba(120,124,116,255); /* Border color similar to table */
}

QScrollBar::handle:horizontal {
    background-color: rgba(120,124,116,180);  /* Scroll handle */
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:horizontal, 
QScrollBar::sub-line:horizontal {
    background: none;
    width: 0px;
}

QScrollBar::add-page:horizontal, 
QScrollBar::sub-page:horizontal {
    background: none;
}
