                     <string notr="true">QRadioButton{
	font: 10pt &quot;Forte&quot;;
	color: rgba(234,234,234,0.5);
	border: 1px solid rgba(68,36,43,255);
	border-right: none;
	border-radius: 10px;
	border-top-right-radius: 0px;
	border-bottom-right-radius: 0px;
	padding: 3px;
}

/* When the radio button is checked, underline the text */
QRadioButton:checked {
color: rgba(32,139,228,255);
background-color: rgba(32,139,228,0.2);
}

QRadioButton:checked{
color: rgba(32,139,228,255);
background-color: rgba(32,139,228,0.1);
}
QRadioButton::indicator {
    width: 20px;  /* Adjust the size */
    height: 20px;
}

/* Custom unchecked state */
QRadioButton::indicator:unchecked {
    image: url(:/cards/close_card.png); /* Replace with your custom image */
}

/* Custom checked state */
QRadioButton::indicator:checked {
    image: url(:/icons/draw.png); /* Replace with your custom image */
}

QSpinBox{
	color: rgba(234,234,234,0.5);
	font: 12pt &quot;Forte&quot;;
	border: 1px solid rgba(68,36,43,255);
	border-left: none;
	border-radius: 10px;
	border-top-left-radius: 0px;
	border-bottom-left-radius: 0px;
	padding: 3px;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
}



</string>
