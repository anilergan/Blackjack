                           <property name="styleSheet">
                            <string notr="true">QComboBox {
    font: 12pt &quot;Arial&quot;;
    color: rgba(212,185,58,255);
    background-color: transparent;
	border:none;

}

QComboBox::hover{
	background-color:  rgba(212,185,58,25);
	border-bottom-left-radius: 0px;
	border-bottom-right-radius: 0px;
	border-right: 2px solid rgba(212,185,58,255);
	border-left: 2px solid rgba(212,185,58,255);

}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    border: 2px solid rgba(212,185,58,255); /* Genel kenarlık */
    background-color: rgba(39,52,45,255); /* Arka plan rengi */
    color: rgb(120,124,116); /* Genel metin rengi */
    border-radius: 15px;
    padding: 10px;
}

/* Seçili öğeyi özelleştirmek için eklenebilecek kısım */
QComboBox QAbstractItemView::item:selected {
	color: rgba(136,182,189,255);

}

</string>
